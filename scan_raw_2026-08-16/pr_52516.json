  "title": "[Bugfix] Fix Mooncake heterogeneous TP with replicated GQA heads",
  "user": {
    "login": "wangyicong52",
    "id": 276921797,
    "node_id": "U_kgDOEIF9xQ",
    "avatar_url": "https://avatars.githubusercontent.com/u/276921797?v=4",
    "gravatar_id": "",
