  "title": "[Metrics] Report shared-prefix tokens lost to a missing sparse-retention checkpoint",
  "user": {
    "login": "Sahil170595",
    "id": 147995121,
    "node_id": "U_kgDOCNI58Q",
    "avatar_url": "https://avatars.githubusercontent.com/u/147995121?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/Sahil170595",
    "html_url": "https://github.com/Sahil170595",
    "followers_url": "https://api.github.com/users/Sahil170595/followers",
    "following_url": "https://api.github.com/users/Sahil170595/following{/other_user}",
    "gists_url": "https://api.github.com/users/Sahil170595/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/Sahil170595/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/Sahil170595/subscriptions",
    "organizations_url": "https://api.github.com/users/Sahil170595/orgs",
    "repos_url": "https://api.github.com/users/Sahil170595/repos",
    "events_url": "https://api.github.com/users/Sahil170595/events{/privacy}",
    "received_events_url": "https://api.github.com/users/Sahil170595/received_events",
