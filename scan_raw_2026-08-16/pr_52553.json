  "title": "[Bugfix] Keep GEMM workspace addresses stable once CUDA graphs may have captured them",
  "user": {
    "login": "yavarb",
    "id": 6343213,
    "node_id": "MDQ6VXNlcjYzNDMyMTM=",
    "avatar_url": "https://avatars.githubusercontent.com/u/6343213?v=4",
